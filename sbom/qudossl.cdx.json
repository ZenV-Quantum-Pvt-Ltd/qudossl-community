  "metadata": {
    "component": {
      "type": "application",
      "name": "qudossl",
      "version": "3.5.7-qudo",
      "description": "OpenSSL 3.5.7 with ML-KEM/ML-DSA delegated to qudo-pqc-lib (single-binary FIPS module)."
    },
    "properties": [
      {
        "name": "note",
        "value": "Hand-authored, version-pinned bill of materials for the SHIPPED product (fips.so + libcrypto/libssl). It exists so a CVE scanner matches by CPE against the real vendored-source components, which filesystem SCA cannot see. Grype (CPE matcher) is the authoritative engine; the security-scan workflow self-tests that matcher against a known-vulnerable pin each run. Keep the OpenSSL version/CPE in lockstep with openssl/VERSION.dat and the qudo pins with the qudo-pqc-lib subtree SHA. nginx and other Sprint-9 test consumers are NOT product components."
      }
    ]
  },
  "components": [
