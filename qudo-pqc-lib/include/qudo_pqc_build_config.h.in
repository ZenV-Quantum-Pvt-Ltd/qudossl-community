/**
 * \file qudo_pqc_build_config.h
 * \brief Auto-generated build configuration — DO NOT EDIT
 *
 * Generated by CMake at configure time. Exposes build-time settings
 * through the public header so consumers (e.g., qudo-provider) can
 * detect FIPS mode without internal include paths.
 */

#ifndef QUDO_PQC_BUILD_CONFIG_H
#define QUDO_PQC_BUILD_CONFIG_H

/* FIPS 140-3 module build — set by -DQUDO_FIPS_MODULE=ON */
#ifndef QUDO_FIPS_MODULE
#cmakedefine QUDO_FIPS_MODULE
#endif

/* Host-DRBG dedupe — set by -DQUDO_PQC_USE_HOST_DRBG=ON (QudoSSL boundary dedupe) */
#ifndef QUDO_PQC_USE_HOST_DRBG
#cmakedefine QUDO_PQC_USE_HOST_DRBG
#endif

/* Embedded-integrity disable — set by -DQUDO_PQC_DISABLE_EMBEDDED_HMAC=ON (host owns integrity) */
#ifndef QUDO_PQC_DISABLE_EMBEDDED_HMAC
#cmakedefine QUDO_PQC_DISABLE_EMBEDDED_HMAC
#endif

#endif /* QUDO_PQC_BUILD_CONFIG_H */
